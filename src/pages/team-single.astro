---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cleanar - Cleaning Services PHP Template";
const showTopbar = true;
---

<BaseLayout title={title} showTopbar={showTopbar}>
<!-- start wpo-page-title -->
                <div class="breadcumb-area box-style">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcumb-wrap">
                                            <h2>Because Clean Feels Better</h2>
                                                                <h3>Team Single</h3>
                                    </div>
            </div>
        </div>
    </div>
</div>        <!-- end page-title -->
        <!-- .team-pg-area start -->
        <div class="team-pg-area section-padding">
            <div class="container">
                <div class="team-single-wrap">
                    <div class="team-info-wrap">
                        <div class="row align-items-center">
                            <div class="col-lg-5">
                                <div class="team-info-img">
                                    <img src="/assets/images/at-single.jpg" alt="">
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="team-info-text">
                                    <h2>Melanie Brown</h2>
                                    <ul>
                                        <li>Position: <span>Junior Member</span></li>
                                        <li>Practice Area:<span>Home Clean, Office Clean</span></li>
                                        <li>Experience:<span>12 Years</span></li>
                                        <li>Address:<span>6391 Elgin St. Celina, Delaware 10299</span></li>
                                        <li>Phone:<span>+00 568 746 987</span></li>
                                        <li>Email:<span>youremail@gmail.com</span></li>
                                    </ul>

                                    <div class="certificates-wrap">
                                        <h2>Certificates</h2>

                                        <div class="certificates-items">
                                            <div class="certificates-item">
                                                <img src="/assets/images/certificate/1.jpg" alt="">
                                            </div>
                                            <div class="certificates-item">
                                                <img src="/assets/images/certificate/2.jpg" alt="">
                                            </div>
                                            <div class="certificates-item">
                                                <img src="/assets/images/certificate/3.jpg" alt="">
                                            </div>
                                            <div class="certificates-item">
                                                <img src="/assets/images/certificate/4.jpg" alt="">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="team-exprience-area team-widget">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="exprience-wrap">
                                    <h2>Personal Experience</h2>
                                    <p>There are many variations of passages of Lorem Ipsum available, but the
                                        majority
                                        have suffered alteration in some form, by injected humour, or randomised
                                        words
                                        which don’t look even slightly believable. If you are going to use a
                                        passage of
                                        Lorem Ipsum, you need to be sure there isn’t anything embarrassing
                                        hidden in the
                                        middle of text.</p>
                                    <p>All the Lorem Ipsum generators on the Internet tend to repeat predefined
                                        chunks
                                        as necessary, making this the first true generator on the Internet. It
                                        uses a
                                        dictionary of over 200 Latin words,</p>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="education-area">
                                    <h2>Education</h2>
                                    <ul>
                                        <li>Academy University School of cleaning, Boston, MA</li>
                                        <li>Admization Institute of cleaning andTechnology, Juzment School of
                                            Management,Cambridge</li>
                                        <li>The Syntify High School Of New York</li>
                                        <li>Education &amp; Court Admissions</li>
                                        <li>Admization Institute of cleaning and Technology, Juzment
                                            School of Management,Cambridge</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="skills-area">
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="exprience-wrap">
                                        <h2>Skills</h2>
                                        <div class="wpo-skill-section">
                                            <div class="wpo-skill-progress">
                                                <div class="wpo-progress-single">
                                                    <h5 class="progress-title">Office Cleaning</h5>
                                                    <div class="progress">
                                                        <div class="progress-bar wow fadeInLeft" data-wow-duration="0.5s" data-wow-delay=".3s" role="progressbar" style="width: 75%" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100">
                                                        </div>
                                                    </div>
                                                    <span class="progress-number">85%</span>
                                                </div>

                                                <div class="wpo-progress-single">
                                                    <h5 class="progress-title">Home Cleaning</h5>
                                                    <div class="progress">
                                                        <div class="progress-bar wow fadeInLeft" data-wow-duration="0.7s" data-wow-delay=".3s" role="progressbar" style="width: 80%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                                        </div>
                                                    </div>
                                                    <span class="progress-number">80%</span>
                                                </div>

                                                <div class="wpo-progress-single">
                                                    <h5 class="progress-title">Bedroom Cleaning</h5>
                                                    <div class="progress">
                                                        <div class="progress-bar wow fadeInLeft" data-wow-duration="0.9s" data-wow-delay=".3s" role="progressbar" style="width: 85%" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100">
                                                        </div>
                                                    </div>
                                                    <span class="progress-number">95%</span>
                                                </div>
                                                <div class="wpo-progress-single">
                                                    <h5 class="progress-title">Window Cleaning</h5>
                                                    <div class="progress">
                                                        <div class="progress-bar wow fadeInLeft" data-wow-duration="0.9s" data-wow-delay=".3s" role="progressbar" style="width: 85%" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100">
                                                        </div>
                                                    </div>
                                                    <span class="progress-number">70%</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="education-area ex-wiget">
                                        <h2>Achievements</h2>
                                        <ul>
                                            <li>Best Cleaner award 2017</li>
                                            <li>Specials awards for Cleaner activity 2018</li>
                                            <li>Won 100 awards in 2025</li>
                                            <li>Super Cleaner Top 50 Cleaner in USA</li>
                                            <li>Young star Award at Cleaner in 2021</li>
                                            <li>Greatest Cleaner Top 10</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="wpo-contact-area ex-wiget">
                        <div class="wpo-contact-title">
                            <h2>Make an Appointment</h2>
                            <p>Do not put off until tomorrow the problems that need to be solved today,
                                especially
                                if it concerns your life!</p>
                        </div>
                        <div class="quote-form">
                            <form>
                                <div class="form-group half-col">
                                    <input type="text" class="form-control" placeholder="Name:" name="name">
                                </div>
                                <div class="form-group half-col">
                                    <input type="email" class="form-control" placeholder="Email:" name="email">
                                </div>
                                <div class="form-group half-col">
                                    <input type="text" class="form-control" placeholder="phone" name="phone">
                                </div>
                                <div class="form-group half-col">
                                    <select name="subject" class="form-control">
                                        <option disabled="disabled" selected="">Subject</option>
                                        <option>Office Cleaning</option>
                                        <option>Home Cleaning</option>
                                        <option>Carpet Cleaning</option>
                                        <option>Window Cleaning</option>
                                    </select>
                                </div>
                                <div class="form-group full-col">
                                    <textarea class="form-control" name="note" placeholder="Case Discription"></textarea>
                                </div>
                                <div class="form-group full-col text-center">
                                    <button class="btn theme-btn-s2" type="submit">Appointment </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- .team-pg-area end -->

        <!-- Start partners -->
        <section class="partners-section section-padding pt-0">
            <h2>Featured by popular companies in the industry</h2>
            <div class="container">
                <ul class="partners-slider slick-initialized slick-slider">
                    <div aria-live="polite" class="slick-list draggable"><div class="slick-track" role="listbox" style="opacity: 1; width: 4528px; transform: translate3d(-1415px, 0px, 0px);"><li class="slick-slide slick-cloned" data-slick-index="-5" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/2.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="-4" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/3.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="-3" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/4.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="-2" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/5.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="-1" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/2.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-current slick-active" data-slick-index="0" aria-hidden="false" tabindex="-1" role="option" aria-describedby="slick-slide00" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/1.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-active" data-slick-index="1" aria-hidden="false" tabindex="-1" role="option" aria-describedby="slick-slide01" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/2.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-active" data-slick-index="2" aria-hidden="false" tabindex="-1" role="option" aria-describedby="slick-slide02" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/3.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-active" data-slick-index="3" aria-hidden="false" tabindex="-1" role="option" aria-describedby="slick-slide03" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/4.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-active" data-slick-index="4" aria-hidden="false" tabindex="-1" role="option" aria-describedby="slick-slide04" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/5.png" alt="">
                        </div>
                    </li><li class="slick-slide" data-slick-index="5" aria-hidden="true" tabindex="-1" role="option" aria-describedby="slick-slide05" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/2.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="6" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/1.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="7" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/2.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="8" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/3.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="9" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/4.png" alt="">
                        </div>
                    </li><li class="slick-slide slick-cloned" data-slick-index="10" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
                        <div>
                            <img src="/assets/images/partners/5.png" alt="">
                        </div>
                    </li></div></div>
                    
                    
                    
                    
                    
                </ul>
            </div>
        </section>
        <!-- end partners -->
</BaseLayout>
