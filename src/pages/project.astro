            <div class="container">
                <ul class="partners-slider slick-initialized slick-slider">
                    <div aria-live="polite" class="slick-list draggable"><div class="slick-track" role="listbox" style="opacity: 1; width: 4528px; transform: translate3d(-1415px, 0px, 0px);"><li class="slick-slide slick-cloned" data-slick-index="-5" id="" aria-hidden="true" tabindex="-1" style="width: 283px;">
