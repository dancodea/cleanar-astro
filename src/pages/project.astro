---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cleanar - Cleaning Services PHP Template";
const showTopbar = true;
---

<BaseLayout title={title} showTopbar={showTopbar}>
<!-- start wpo-page-title -->
                <div class="breadcumb-area box-style">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcumb-wrap">
                                            <h2>Because Clean Feels Better</h2>
                                                                <h3>projects page</h3>
                                    </div>
            </div>
        </div>
    </div>
</div>        <!-- end page-title -->
        <!-- start wpo-project-section -->
        <section class="wpo-project-section section-padding">
            <div class="wpo-project-wrap">
                <div class="container">
                    <div class="wpo-project-slide-item">
                        <div class="row">
                            <div class="col-lg-7 col-md-7 col-12">
                                <div class="wpo-project-item wow fadeInUp" data-wow-duration="1000ms">
                                    <div class="wpo-project-img middle-light">
                                        <img src="/assets/images/project/1.jpg" alt="">
                                    </div>
                                    <div class="wpo-project-text">
                                        <div class="thumb">
                                            <span>Bedroom Cleaning</span>
                                        </div>
                                        <h2><a href="/project-single">Residential Cleaning</a></h2>
                                        <a class="arrow" href="/project-single"><i class="ti-arrow-top-right" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 col-md-5 col-12">
                                <div class="wpo-project-item wow fadeInUp" data-wow-duration="1000ms">
                                    <div class="wpo-project-img middle-light">
                                        <img src="/assets/images/project/2.jpg" alt="">
                                    </div>
                                    <div class="wpo-project-text">
                                        <div class="thumb">
                                            <span>Window Cleaning</span>
                                        </div>
                                        <h2><a href="/project-single">Indoor Cleaning</a></h2>
                                        <a class="arrow" href="/project-single"><i class="ti-arrow-top-right" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 col-md-5 col-12">
                                <div class="wpo-project-item wow fadeInUp" data-wow-duration="1000ms">
                                    <div class="wpo-project-img middle-light">
                                        <img src="/assets/images/project/3.jpg" alt="">
                                    </div>
                                    <div class="wpo-project-text">
                                        <div class="thumb">
                                            <span>table Cleaning</span>
                                        </div>
                                        <h2><a href="/project-single">Office Cleaning</a></h2>
                                        <a class="arrow" href="/project-single"><i class="ti-arrow-top-right" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-7 col-md-7 col-12">
                                <div class="wpo-project-item wow fadeInUp" data-wow-duration="1000ms">
                                    <div class="wpo-project-img middle-light">
                                        <img src="/assets/images/project/4.jpg" alt="">
                                    </div>
                                    <div class="wpo-project-text">
                                        <div class="thumb">
                                            <span>hotel Cleaning</span>
                                        </div>
                                        <h2><a href="/project-single">Residential Cleaning</a></h2>
                                        <a class="arrow" href="/project-single"><i class="ti-arrow-top-right" aria-hidden="true"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-8 col-md-7 col-12">
                                <div class="wpo-project-item wow fadeInUp" data-wow-duration="1000ms">
                                    <div class="wpo-project-img middle-light">
                                        <img src="/assets/images/project/5.jpg" alt="">
