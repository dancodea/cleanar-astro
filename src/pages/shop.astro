---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cleanar - Cleaning Services PHP Template";
const showTopbar = true;
---

<BaseLayout title={title} showTopbar={showTopbar}>
<!-- start wpo-page-title -->
                <div class="breadcumb-area box-style">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcumb-wrap">
                                            <h2>Because Clean Feels Better</h2>
                                                                <h3>Shop</h3>
                                    </div>
            </div>
        </div>
    </div>
</div>        <!-- end page-title -->
        <!-- start shop-section -->
        <section class="shop-section section-padding">
            <div class="container">
                <div class="row">
                    <div class="col col-xs-12">
                        <div class="shop-grids clearfix">
                            <div class="grid" style="position: relative; height: 0px;">
                                <div class="img-holder">
                                    <img src="/assets/images/shop/1.jpg" alt="">
                                </div>
                                <div class="details">
                                    <h3><a href="/shop-single">Window &amp; Glass Cleaner</a></h3>
                                    <del>$25.00</del><span>$22.00</span>
                                    <div class="add-to-cart">
                                        <a href="#">Add to cart <i class="ti-shopping-cart"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="grid">
                                <div class="img-holder">
                                    <img src="/assets/images/shop/2.jpg" alt="">
                                </div>
                                <div class="details">
                                    <h3><a href="/shop-single">Long Handle Floor Brush</a></h3>
                                    <del>$25.00</del><span>$22.00</span>
                                    <div class="add-to-cart">
                                        <a href="#">Add to cart <i class="ti-shopping-cart"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="grid">
                                <div class="img-holder">
                                    <img src="/assets/images/shop/3.jpg" alt="">
                                </div>
                                <div class="details">
                                    <h3><a href="/shop-single">Commercial Cleaner</a></h3>
                                    <del>$25.00</del><span>$22.00</span>
                                    <div class="add-to-cart">
                                        <a href="#">Add to cart <i class="ti-shopping-cart"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="grid">
                                <div class="img-holder">
                                    <img src="/assets/images/shop/4.jpg" alt="">
                                </div>
                                <div class="details">
                                    <h3><a href="/shop-single">Dryer Cleaning Brush</a></h3>
                                    <del>$25.00</del><span>$22.00</span>
                                    <div class="add-to-cart">
                                        <a href="#">Add to cart <i class="ti-shopping-cart"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="grid">
                                <div class="img-holder">
                                    <img src="/assets/images/shop/5.jpg" alt="">
                                </div>
                                <div class="details">
                                    <h3><a href="/shop-single">Dusting Microfiber Gloves</a></h3>
                                    <del>$25.00</del><span>$22.00</span>
                                    <div class="add-to-cart">
                                        <a href="#">Add to cart <i class="ti-shopping-cart"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="grid">
                                <div class="img-holder">
                                    <img src="/assets/images/shop/6.jpg" alt="">
                                </div>
                                <div class="details">
                                    <h3><a href="/shop-single">Rotating Cleaning Brush</a></h3>
                                    <del>$25.00</del><span>$22.00</span>
                                    <div class="add-to-cart">
                                        <a href="#">Add to cart <i class="ti-shopping-cart"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="pagination-wrapper pagination-wrapper-center">
                            <ul class="pg-pagination">
                                <li>
                                    <a href="#" aria-label="Previous">
                                        <i class="ti-angle-left"></i>
                                    </a>
                                </li>
                                <li class="active"><a href="#">1</a></li>
                                <li><a href="#">2</a></li>
                                <li><a href="#">3</a></li>
                                <li>
                                    <a href="#" aria-label="Next">
                                        <i class="ti-angle-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div> <!-- end container -->
        </section>
        <!-- end shop-section -->
</BaseLayout>
