---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cleanar - Cleaning Services PHP Template";
const showTopbar = true;
---

<BaseLayout title={title} showTopbar={showTopbar}>
<!-- start wpo-page-title -->
                <div class="breadcumb-area box-style">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="breadcumb-wrap">
                                            <h2>Because Clean Feels Better</h2>
                                                                <h3>Error 404</h3>
                                    </div>
            </div>
        </div>
    </div>
</div>        <!-- end page-title -->
        <!-- start error-404-section -->
        <section class="error-404-section section-padding">
            <div class="container">
                <div class="row">
                    <div class="col col-xs-12">
                        <div class="content clearfix">
                            <div class="error">
                                <img src="/assets/images/404.png" alt="">
                            </div>
                            <div class="error-message">
                                <h3>we’re sorry page not found!</h3>
                                <a href="/" class="theme-btn">Back to home</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- end error-404-section -->
</BaseLayout>
