---
interface Props {
  showTopbar?: boolean;
  headerClass?: string;
}

const {
  showTopbar = true,
  headerClass = "box-style"
} = Astro.props;
---

<!-- Start header -->
<header id="header" class={headerClass}>
    {showTopbar && (
        <!-- start topbar -->
        <div class="topbar">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-lg-8 col-12">
                        <ul class="contact-info">
                            <li>
                                <a href="tel:+887869587496">
                                    <i class="flaticon-phone"></i><span>+88 7869 5874 96</span>
                                </a>
                            </li>
                            <li>
                                <a href="mailto:support@user.com">
                                    <i class="ti-email"></i><span>support@user.com</span>
                                </a>
                            </li>
                            <li>
                                <i class="ti-location-pin"></i><span>54 Berrick St Boston MA 02115</span>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-4 col-12">
                        <div class="contact-into">
                            <div class="language-selector">
                                <select id="languageSelect">
                                    <option value="en" data-icon="/assets/images/language/1.svg">English</option>
                                    <option value="sp" data-icon="/assets/images/language/2.svg">Spanish</option>
                                </select>
                                <div class="custom-select-wrapper">
                                    <div class="custom-select"><img src="/assets/images/language/1.svg" alt=""> English</div>
                                    <div class="custom-arrow"><i class="ti-angle-down"></i></div>
                                </div>
                                <div class="custom-options">
                                    <div><img src="/assets/images/language/1.svg" alt=""> English</div>
                                    <div><img src="/assets/images/language/2.svg" alt=""> Spanish</div>
                                </div>
                            </div>
                            <div class="pryment-selector">
                                <select>
                                    <option value="usd">USD</option>
                                    <option value="aud">AUD</option>
                                </select>
                            </div>
                            <ul class="social-media">
                                <li><a href="#" aria-label="Facebook"><i class="flaticon-facebook-app-symbol"></i></a></li>
                                <li><a href="#" aria-label="LinkedIn"><i class="flaticon-linkedin"></i></a></li>
                                <li><a href="#" aria-label="Instagram"><i class="flaticon-camera"></i></a></li>
                                <li><a href="#" aria-label="Vimeo"><i class="flaticon-vimeo"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- end topbar -->
    )}

    <div class="wpo-site-header">
        <nav class="navigation navbar navbar-expand-lg navbar-light original">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-lg-3 col-md-3 col-3 d-lg-none dl-block">
                        <div class="mobail-menu">
                            <button type="button" class="navbar-toggler open-btn" aria-label="Toggle navigation">
                                <span class="sr-only">Toggle navigation</span>
                                <span class="icon-bar first-angle"></span>
                                <span class="icon-bar middle-angle"></span>
                                <span class="icon-bar last-angle"></span>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 col-6">
                        <div class="navbar-header">
                            <a class="navbar-brand" href="/"><img src="/assets/images/logo.svg" alt="Cleanar Logo"></a>
                        </div>
                    </div>
                    <div class="col-lg-7 col-md-1 col-1">
                        <div id="navbar" class="collapse navbar-collapse navigation-holder">
                            <button class="menu-close" aria-label="Close menu"><i class="ti-close"></i></button>
                            <ul class="nav navbar-nav mb-2 mb-lg-0">
                                <li class="menu-item-has-children">
                                    <a href="/">Home</a>
                                    <ul class="sub-menu">
                                        <li><a href="/">Home style 1</a></li>
                                        <li><a href="/index-2">Home style 2</a></li>
                                        <li><a href="/index-3">Home style 3</a></li>
                                    </ul>
                                </li>
                                <li class="menu-item-has-children">
                                    <a href="/about">Pages</a>
                                    <ul class="sub-menu">
                                        <li><a href="/about">About</a></li>
                                        <li><a href="/appoinment">Appoinment</a></li>
                                        <li><a href="/project">Portfolio</a></li>
                                        <li><a href="/project-single">Portfolio Single</a></li>
                                        <li><a href="/team">Team Page</a></li>
                                        <li><a href="/team-single">Team Single</a></li>
                                        <li><a href="/faq">Faq Page</a></li>
                                        <li><a href="/404">404 Error</a></li>
                                    </ul>
                                </li>
                                <li class="menu-item-has-children">
                                    <a href="/service">services</a>
                                    <ul class="sub-menu">
                                        <li><a href="/service">services</a></li>
                                        <li><a href="/service-single">services Single</a></li>
                                    </ul>
                                </li>
                                <li class="menu-item-has-children">
                                    <a href="/project">Projects</a>
                                    <ul class="sub-menu">
                                        <li><a href="/project">Projects</a></li>
                                        <li><a href="/project-single">Project Single</a></li>
                                    </ul>
                                </li>
                                <li class="menu-item-has-children">
                                    <a href="/shop">Shop</a>
                                    <ul class="sub-menu">
                                        <li><a href="/shop">Shop</a></li>
                                        <li><a href="/shop-single">Shop Single</a></li>
                                        <li><a href="/cart">Cart</a></li>
                                        <li><a href="/checkout">Checkout</a></li>
                                    </ul>
                                </li>
                                <li class="menu-item-has-children">
                                    <a href="/blog">Blog</a>
                                    <ul class="sub-menu">
                                        <li><a href="/blog">Blog right sidebar</a></li>
                                        <li><a href="/blog-left-sidebar">Blog left sidebar</a></li>
                                        <li><a href="/blog-fullwidth">Blog fullwidth</a></li>
                                        <li class="menu-item-has-children">
                                            <a href="/blog-single">Blog details</a>
                                            <ul class="sub-menu">
                                                <li><a href="/blog-single">Blog details right sidebar</a></li>
                                                <li><a href="/blog-single-left-sidebar">Blog details left sidebar</a></li>
                                                <li><a href="/blog-single-fullwidth">Blog details fullwidth</a></li>
                                            </ul>
                                        </li>
                                    </ul>
                                </li>
                                <li><a href="/contact">contact</a></li>
                            </ul>
                        </div>
                        <!-- end of nav-collapse -->
                    </div>
                    <div class="col-lg-3 col-md-2 col-2">
                        <div class="header-right">
                            <div class="header-search-form-wrapper">
                                <div class="cart-search-contact">
                                    <button class="search-toggle-btn" aria-label="Search"><i class="fi flaticon-magnifying-glass"></i></button>
                                    <div class="header-search-form">
                                        <form onsubmit="event.preventDefault();">
                                            <div>
                                                <input type="text" class="form-control" placeholder="Search here...">
                                                <button type="submit" aria-label="Submit search"><i class="fi flaticon-magnifying-glass"></i></button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="mini-cart">
                                <button class="cart-toggle-btn" aria-label="Shopping Cart">
                                    <i class="fi flaticon-bag"></i>
                                    <span class="cart-count">2</span>
                                </button>
                                <div class="mini-cart-content">
                                    <button class="mini-cart-close" aria-label="Close cart"><i class="ti-close"></i></button>
                                    <div class="mini-cart-items">
                                        <div class="mini-cart-item clearfix">
                                            <div class="mini-cart-item-image">
                                                <a href="/shop"><img src="/assets/images/shop/mini-cart/img-1.jpg" alt="Product"></a>
                                            </div>
                                            <div class="mini-cart-item-des">
                                                <a href="/shop">Window & Glass Cleaner</a>
                                                <span class="mini-cart-item-price">$20.15 x 1</span>
                                                <span class="mini-cart-item-quantity"><a href="#" aria-label="Remove item"><i class="ti-close"></i></a></span>
                                            </div>
                                        </div>
                                        <div class="mini-cart-item clearfix">
                                            <div class="mini-cart-item-image">
                                                <a href="/shop"><img src="/assets/images/shop/mini-cart/img-2.jpg" alt="Product"></a>
                                            </div>
                                            <div class="mini-cart-item-des">
                                                <a href="/shop">Rotating Cleaning Brush</a>
                                                <span class="mini-cart-item-price">$13.25 x 2</span>
                                                <span class="mini-cart-item-quantity"><a href="#" aria-label="Remove item"><i class="ti-close"></i></a></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mini-cart-action clearfix">
                                        <span class="mini-checkout-price">Subtotal:
                                            <span>$215.14</span></span>
                                        <div class="mini-btn">
                                            <a href="/checkout" class="view-cart-btn s1">Checkout</a>
                                            <a href="/cart" class="view-cart-btn">View Cart</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="close-form">
                                <a class="theme-btn" href="/appoinment">Free Quote</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div><!-- end of container -->
        </nav>
    </div>
</header>
<!-- end of header -->
